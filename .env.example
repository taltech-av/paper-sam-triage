# Machine-specific paths. Copy to `.env` and edit; config.py reads it at import
# and never overrides variables you already exported. Nothing else in the
# codebase hardcodes a location.
#
# Only VLM_DATA_ROOT is required for the offline reproduction path (see
# REPRODUCE.md); the rest are needed to re-run the pipeline or rebuild splits.

# Where the artifact bundle was unpacked: contains camera/, lidar_png/,
# annotation_sam/, vlm/<tag>/results/. Defaults to ./data.
VLM_DATA_ROOT=/path/to/zod_temp

# Original full-resolution ZOD release (single_frames/). Crops are taken from
# these when set, and from the downscaled 768 px camera/ images when unset.
# Required by make_splits.py, which reads ZOD frame metadata for weather.
# VLM_ZOD_ROOT=/path/to/zod-data/single_frames

# Checkout of the paper-sam-triage-training repo supplying the CLFTv2/Swin
# quality model. Defaults to ../paper-sam-triage-training next to this repo.
# VLM_FUSION_DIR=/path/to/paper-sam-triage-training

# Override the Swin config/checkpoint individually if they live outside
# FUSION_DIR — e.g. when only the checkpoint was downloaded from the bundle.
# VLM_SWIN_CFG=/path/to/config_9.json
# VLM_SWIN_CKPT=/path/to/best.pth
# VLM_SWIN_DEVICE=cuda:0

# Frame list the pipeline iterates. Defaults to frames/bad_frames.csv; the
# published runs used frames/vlm_frames.csv (the canonical 4,110).
# VLM_FRAMES_FILE=frames/vlm_frames.csv

# --- HPC (only consulted when --hpc is passed) ---
# VLM_HPC_DATA_ROOT=/scratch/you/zod_temp
# VLM_HPC_ZOD_ROOT=/scratch/you/zod-data/single_frames
# VLM_HPC_FUSION_DIR=/scratch/you/paper-sam-triage-training
# VLM_HPC_SWIN_DIR=/scratch/you/models/swin

# --- Ollama ---
# OLLAMA_HOST=localhost:11434
